{
  "name": "dsh-draw2code",
  "version": "0.1.1",
  "description": "Human-AI collaborative prototyping for DeepSeek Harness, from product clarification to editable Excalidraw wireframes and verified frontend generation.",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "dsh-better-sidebar"
      ],
      "platform": "web"
    }
  },
  "files": [
    "dist",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.en.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.2.0-0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.2.0-0",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.6 <0.2.0-0",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.6 <0.2.0-0",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.2.0-0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0-0",
    "@deepseek-ai/dsh-workspace": ">=0.1.0-rc.6 <0.2.0-0",
    "dsh-better-sidebar": ">=0.12.3 <0.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-workspace": "^0.1.0-rc.6",
    "@excalidraw/excalidraw": "^0.18.0",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.5",
    "dsh-better-sidebar": "^0.12.3",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "~5.7.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/guchang/draw2code.git"
  },
  "homepage": "https://github.com/guchang/draw2code#readme",
  "bugs": {
    "url": "https://github.com/guchang/draw2code/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "excalidraw",
    "prototype",
    "wireframe",
    "vibe-coding"
  ],
  "license": "Apache-2.0"
}
